{
  "name": "@will-i-be-cold/heat",
  "version": "0.1.0",
  "description": "Cold-weather thermal physics for backpackers: ISO 11079 IREQ for clothed phases, ISO 23537 Annex C for sleep, and gear-coverage analysis.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MODEL.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
